#!/bin/bash
# scripts/health-check.sh - Sistem Sağlık Kontrolü

echo "🏥 CodeAssist Sistem Sağlık Kontrolü"
echo "===================================="
echo

# Renk kodları
GREEN='\033[0;32m'
RED='\033[0;31m'
YELLOW='\033[1;33m'
NC='\033[0m'

check_pass() {
    echo -e "${GREEN}[✓]${NC} $1"
}

check_fail() {
    echo -e "${RED}[✗]${NC} $1"
}

check_warn() {
    echo -e "${YELLOW}[!]${NC} $1"
}

# 1. Python kontrolü
echo "🐍 Python Kontrolü"
if command -v python3 &> /dev/null; then
    PYTHON_VER=$(python3 --version | cut -d' ' -f2)
    if [[ $(echo "$PYTHON_VER >= 3.10" | bc -l) -eq 1 ]]; then
        check_pass "Python $PYTHON_VER kurulu"
    else
        check_warn "Python $PYTHON_VER (3.10+ önerilir)"
    fi
else
    check_fail "Python kurulu değil"
fi
echo

# 2. Docker kontrolü
echo "🐳 Docker Kontrolü"
if command -v docker &> /dev/null; then
    DOCKER_VER=$(docker --version | cut -d' ' -f3 | tr -d ',')
    check_pass "Docker $DOCKER_VER kurulu"
    
    if systemctl is-active --quiet docker; then
        check_pass "Docker servisi çalışıyor"
    else
        check_fail "Docker servisi çalışmıyor"
    fi
    
    if groups | grep -q docker; then
        check_pass "Kullanıcı docker grubunda"
    else
        check_fail "Kullanıcı docker grubunda değil"
    fi
else
    check_fail "Docker kurulu değil"
fi
echo

# 3. UV kontrolü
echo "📦 UV Kontrolü"
if command -v uv &> /dev/null; then
    UV_VER=$(uv --version | cut -d' ' -f2)
    check_pass "UV $UV_VER kurulu"
else
    check_fail "UV kurulu değil"
fi
echo

# 4. Git kontrolü
echo "🔧 Git Kontrolü"
if command -v git &> /dev/null; then
    GIT_VER=$(git --version | cut -d' ' -f3)
    check_pass "Git $GIT_VER kurulu"
else
    check_fail "Git kurulu değil"
fi
echo

# 5. CodeAssist dizini
echo "📁 CodeAssist Dizini"
if [ -d "$HOME/codeassist" ]; then
    check_pass "CodeAssist dizini mevcut"
    
    if [ -d "$HOME/codeassist/persistent-data" ]; then
        check_pass "Veri dizini mevcut"
    else
        check_warn "Veri dizini bulunamadı"
    fi
else
    check_fail "CodeAssist dizini bulunamadı"
fi
echo

# 6. Port kontrolü
echo "🌐 Port Kontrolü"
if lsof -Pi :3000 -sTCP:LISTEN -t >/dev/null 2>&1; then
    check_warn "Port 3000 kullanımda"
    PID=$(lsof -ti:3000)
    PROCESS=$(ps -p $PID -o comm=)
    echo "   Process: $PROCESS (PID: $PID)"
else
    check_pass "Port 3000 boş"
fi
echo

# 7. Disk alanı
echo "💾 Disk Alanı"
DISK_FREE=$(df -BG ~ | awk 'NR==2 {print $4}' | sed 's/G//')
if [ "$DISK_FREE" -gt 20 ]; then
    check_pass "$DISK_FREE GB boş alan"
elif [ "$DISK_FREE" -gt 10 ]; then
    check_warn "$DISK_FREE GB boş alan (20+ önerilir)"
else
    check_fail "$DISK_FREE GB boş alan (kritik seviye!)"
fi
echo

# 8. RAM kontrolü
echo "🧠 RAM Kontrolü"
TOTAL_RAM=$(free -g | awk '/^Mem:/{print $2}')
USED_RAM=$(free -g | awk '/^Mem:/{print $3}')
if [ "$TOTAL_RAM" -ge 8 ]; then
    check_pass "$TOTAL_RAM GB toplam RAM"
else
    check_warn "$TOTAL_RAM GB toplam RAM (8+ önerilir)"
fi
echo

# 9. CPU kontrolü
echo "⚙️  CPU Kontrolü"
CPU_CORES=$(nproc)
if [ "$CPU_CORES" -ge 4 ]; then
    check_pass "$CPU_CORES CPU çekirdeği"
else
    check_warn "$CPU_CORES CPU çekirdeği (4+ önerilir)"
fi
echo

# 10. İnternet bağlantısı
echo "🌍 İnternet Bağlantısı"
if ping -c 1 huggingface.co &> /dev/null; then
    check_pass "Hugging Face erişilebilir"
else
    check_fail "Hugging Face erişilemiyor"
fi
echo

# Özet
echo "===================================="
echo "📊 Sağlık Kontrolü Tamamlandı"
echo
echo "Öneriler:"
echo "  • Hata varsa install.sh scriptini çalıştırın"
echo "  • Docker grubu için oturumu yenileyin"
echo "  • Disk alanı azsa temizlik yapın"
echo

---

#!/bin/bash
# scripts/update.sh - CodeAssist Güncelleme

echo "🔄 CodeAssist Güncelleme Scripti"
echo "================================"
echo

cd ~/codeassist || exit

# Değişiklikleri kontrol et
if ! git diff-index --quiet HEAD --; then
    echo "⚠️  Yerel değişiklikler tespit edildi"
    read -p "Değişiklikleri saklamak ister misiniz? (e/h): " choice
    if [[ "$choice" == "e" ]]; then
        git stash save "Güncelleme öncesi yedek $(date +%Y%m%d_%H%M%S)"
        echo "✓ Değişiklikler saklandı"
    fi
fi

# Güncellemeleri çek
echo "📥 Güncellemeler çekiliyor..."
git pull origin main

# Bağımlılıkları güncelle
echo "📦 Bağımlılıklar güncelleniyor..."
uv sync --upgrade

echo
echo "✅ Güncelleme tamamlandı!"
echo "CodeAssist'i yeniden başlatın: uv run run.py"

---

#!/bin/bash
# scripts/backup.sh - Veri Yedekleme

BACKUP_DIR="$HOME/codeassist_backups"
TIMESTAMP=$(date +%Y%m%d_%H%M%S)
BACKUP_FILE="codeassist_backup_$TIMESTAMP.tar.gz"

echo "💾 CodeAssist Yedekleme"
echo "======================"
echo

# Yedek dizinini oluştur
mkdir -p "$BACKUP_DIR"

# Verileri yedekle
echo "📦 Veriler yedekleniyor..."
cd ~/codeassist
tar -czf "$BACKUP_DIR/$BACKUP_FILE" \
    persistent-data/ \
    --exclude='*.log' \
    --exclude='*.cache'

echo "✅ Yedekleme tamamlandı!"
echo "Dosya: $BACKUP_DIR/$BACKUP_FILE"
echo "Boyut: $(du -h "$BACKUP_DIR/$BACKUP_FILE" | cut -f1)"

# Eski yedekleri temizle (30 günden eski)
echo
echo "🧹 Eski yedekler temizleniyor..."
find "$BACKUP_DIR" -name "codeassist_backup_*.tar.gz" -mtime +30 -delete
echo "✓ 30 günden eski yedekler silindi"

---

#!/bin/bash
# scripts/restore.sh - Yedek Geri Yükleme

BACKUP_DIR="$HOME/codeassist_backups"

echo "♻️  CodeAssist Yedek Geri Yükleme"
echo "================================="
echo

# Yedekleri listele
echo "Mevcut yedekler:"
ls -lht "$BACKUP_DIR"/codeassist_backup_*.tar.gz 2>/dev/null | nl

if [ $? -ne 0 ]; then
    echo "❌ Hiç yedek bulunamadı!"
    exit 1
fi

echo
read -p "Hangi yedeği geri yüklemek istiyorsunuz? (numara): " choice

BACKUP_FILE=$(ls -t "$BACKUP_DIR"/codeassist_backup_*.tar.gz | sed -n "${choice}p")

if [ -z "$BACKUP_FILE" ]; then
    echo "❌ Geçersiz seçim!"
    exit 1
fi

echo
echo "⚠️  UYARI: Mevcut veriler silinecek!"
read -p "Devam etmek istiyor musunuz? (e/h): " confirm

if [[ "$confirm" != "e" ]]; then
    echo "❌ İşlem iptal edildi"
    exit 0
fi

# Mevcut verileri yedekle
echo "📦 Mevcut veriler yedekleniyor..."
cd ~/codeassist
mv persistent-data persistent-data.old

# Yedeği geri yükle
echo "♻️  Yedek geri yükleniyor..."
tar -xzf "$BACKUP_FILE" -C ~/codeassist

echo "✅ Geri yükleme tamamlandı!"
echo "Eski veriler: ~/codeassist/persistent-data.old"
echo "CodeAssist'i başlatın: cd ~/codeassist && uv run run.py"

---

#!/bin/bash
# scripts/clean.sh - Sistem Temizliği

echo "🧹 CodeAssist Sistem Temizliği"
echo "=============================="
echo

# Docker temizliği
echo "🐳 Docker temizleniyor..."
docker system prune -f
echo "✓ Docker temizlendi"
echo

# Python cache temizliği
echo "🐍 Python cache temizleniyor..."
find ~/codeassist -type d -name __pycache__ -exec rm -rf {} + 2>/dev/null
find ~/codeassist -type f -name "*.pyc" -delete 2>/dev/null
echo "✓ Python cache temizlendi"
echo

# Log temizliği
echo "📝 Loglar temizleniyor..."
find ~/codeassist -name "*.log" -mtime +7 -delete 2>/dev/null
echo "✓ Eski loglar silindi"
echo

# UV cache temizliği
echo "📦 UV cache temizleniyor..."
uv cache clean
echo "✓ UV cache temizlendi"
echo

# Disk kullanımı
echo "💾 Disk kullanımı:"
du -sh ~/codeassist
echo

echo "✅ Temizlik tamamlandı!"

---

#!/bin/bash
# scripts/uninstall.sh - CodeAssist Kaldırma

echo "🗑️  CodeAssist Kaldırma"
echo "======================="
echo

echo "⚠️  UYARI: Bu işlem şunları kaldıracak:"
echo "  • CodeAssist uygulaması"
echo "  • Tüm eğitim verileri"
echo "  • Masaüstü kısayolu"
echo "  • Docker container'ları"
echo

read -p "Devam etmek istiyor musunuz? (EVET yazın): " confirm

if [[ "$confirm" != "EVET" ]]; then
    echo "❌ İşlem iptal edildi"
    exit 0
fi

# Yedek oluştur
read -p "Verilerinizi yedeklemek ister misiniz? (e/h): " backup

if [[ "$backup" == "e" ]]; then
    ./scripts/backup.sh
fi

# CodeAssist'i durdur
echo "⏹️  CodeAssist durduruluyor..."
pkill -f "run.py"

# Docker temizliği
echo "🐳 Docker container'ları temizleniyor..."
docker ps -a | grep codeassist | awk '{print $1}' | xargs docker rm -f 2>/dev/null

# Dosyaları sil
echo "📁 Dosyalar siliniyor..."
rm -rf ~/codeassist

# Masaüstü kısayolunu sil
echo "🗑️  Kısayol siliniyor..."
rm -f ~/.local/share/applications/codeassist.desktop

echo
echo "✅ CodeAssist kaldırıldı!"
echo
echo "Not: Docker, UV ve diğer bağımlılıklar kaldırılmadı."
echo "Bunları da kaldırmak isterseniz:"
echo "  sudo apt remove docker.io"
echo "  rm -rf ~/.local/bin/uv"
